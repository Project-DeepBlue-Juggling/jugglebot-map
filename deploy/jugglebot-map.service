[Unit]
Description=jugglebot-map project-map server (API + built frontend, port 8765)
Documentation=file:///home/jeeves/jugglebot-map/README.md
# The writer pushes to origin as soon as an edit lands, so wait for the network.
Wants=network-online.target
After=network-online.target
# Appliance behaviour, as tools/systemd/jugglebot-gui.service upstream: never
# land in "start-limit-hit"; a crash loop keeps retrying.
StartLimitIntervalSec=0

[Service]
Type=simple
User=jeeves
WorkingDirectory=/home/jeeves/jugglebot-map
# --repo is the checkout whose map/ is served and committed (branch main only;
# on any other branch the server serves read-only under a warning banner).
ExecStart=/home/jeeves/jugglebot-map/.venv/bin/jugglebot-map --repo /home/jeeves/Jugglebot --host 0.0.0.0 --port 8765 --no-open
# Unbuffered so the startup lines (git writer on/off) show at once in
# `journalctl -u jugglebot-map`.
Environment=PYTHONUNBUFFERED=1
# git must never wait for a password on a headless box: a missing credential
# fails the push (red banner) instead of hanging the writer.
Environment=GIT_TERMINAL_PROMPT=0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
