[Unit]
Description=jugglebot-map project-map server (API + built frontend, port 8765)
Documentation=file:///home/jetson/map-live/jugglebot-map/README.md
# The writer pushes to origin as soon as an edit lands, so wait for the network.
Wants=network-online.target
After=network-online.target
# Appliance behaviour: never land in "start-limit-hit"; a crash loop keeps retrying.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/jetson/map-live/jugglebot-map
# --repo is the data clone whose map/ is served and committed (branch main only; on any
# other branch the server serves read-only under a warning banner). Never the robot's checkout.
ExecStart=/home/jetson/map-live/jugglebot-map/.venv/bin/jugglebot-map --repo /home/jetson/map-live/Jugglebot --host 0.0.0.0 --port 8765 --no-open
Environment=PYTHONUNBUFFERED=1
Environment=GIT_TERMINAL_PROMPT=0
# The 04:00 nightly's status files, read-only (the server never writes there).
Environment=MAP_NIGHTLY_DIR=/home/jetson/Desktop/Jugglebot/temp/reports/nightly
# Browsers on the Jugglebot GUI's origin may file items here.
Environment=MAP_CORS_ORIGINS=http://192.168.20.34:8081,http://jetson.local:8081,http://localhost:8081
Restart=on-failure
RestartSec=3
# This Jetson runs the robot: keep the map server behind the control loops.
# Keep ROS2 first. Nice=10 is the protection that is actually enforced here:
# this Jetson runs systemd 245 on a hybrid cgroup-v1 tree, so a --user manager
# has no delegated cpu/memory controllers and the four lines below are accepted
# but not applied (measured 2026-10-25: the process sits in the shared
# /user.slice cpu cgroup). They take effect if the box moves to cgroup v2.
# Idle cost measured the same day: 0.3 % of one core, about 60 MB RSS.
Nice=10
CPUWeight=20
IOWeight=20
CPUQuota=20%
MemoryMax=300M

[Install]
WantedBy=default.target
